{
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.organizeImports": "never"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "cSpell.words": [
        "btrim",
        "daterange",
        "dpage",
        "Elantra",
        "Fabia",
        "fkey",
        "geist",
        "healthcheck",
        "ILIKE",
        "isready",
        "nums",
        "Passat",
        "pgadmin",
        "pgdata",
        "plpgsql",
        "postgres",
        "postgresql",
        "Qashqai",
        "sonarjs",
        "Sportage",
        "WATCHPACK"
    ]
}